{
  "name": "myth-ritual-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 127.0.0.1 --port 3001",
    "dev:api": "python -m uvicorn app.main:app --app-dir api --reload --host 127.0.0.1 --port 8010",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3001",
    "typecheck": "tsc -b --pretty false",
    "test:web": "vitest run",
    "test:api": "python -m pytest api/tests",
    "test": "npm run typecheck && npm run test:web && npm run test:api"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "opencc-js": "^1.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "jsdom": "^27.2.0",
    "vitest": "^4.0.18"
  }
}
