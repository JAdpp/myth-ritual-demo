{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/c3-story-versions.schema.json",
  "title": "C3 development product-primary story corpus",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_version",
    "snapshot_date",
    "corpus_tier",
    "editorial_status",
    "production_eligible",
    "development_runtime_eligible",
    "primary_selection_status",
    "story_versions"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "corpus_version": { "type": "string", "pattern": "^c3-dev-" },
    "snapshot_date": { "type": "string", "format": "date" },
    "corpus_tier": { "const": "c3-dev" },
    "editorial_status": { "const": "editorial_draft" },
    "production_eligible": { "const": false },
    "development_runtime_eligible": { "const": true },
    "primary_selection_status": { "const": "demo_editorial_selection_pending_expert_review" },
    "story_versions": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/storyVersion" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "storyVersion": {
      "type": "object",
      "required": [
        "story_version_id",
        "story_family_id",
        "product_primary",
        "record_role",
        "primary_selection_status",
        "eligible_for_demo",
        "story_type",
        "motifs",
        "source_canon",
        "story_card",
        "adaptation_boundary",
        "theatre_asset_pack",
        "rights_and_access",
        "review_record",
        "production_eligible",
        "development_runtime_eligible"
      ],
      "properties": {
        "story_version_id": { "type": "string", "minLength": 3 },
        "story_family_id": { "type": "string", "minLength": 3 },
        "product_primary": { "const": true },
        "record_role": { "const": "product_primary_story" },
        "primary_selection_status": { "const": "demo_editorial_selection_pending_expert_review" },
        "eligible_for_demo": { "const": true },
        "story_type": { "type": "string", "minLength": 1 },
        "motifs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "production_eligible": { "const": false },
        "development_runtime_eligible": { "type": "boolean" },
        "adult_only": { "type": "boolean" },
        "default_offer_eligible": { "type": "boolean" },
        "requires_explicit_adult_opt_in": { "type": "boolean" },
        "source_canon": {
          "type": "object",
          "required": [
            "immutable",
            "work",
            "evidence_anchor",
            "source_permalink",
            "page_revision_id",
            "page_revision_timestamp",
            "original_excerpt",
            "excerpt_sha256",
            "ending"
          ],
          "properties": {
            "immutable": { "const": true },
            "page_revision_id": { "type": "integer", "minimum": 1 },
            "source_permalink": { "type": "string", "format": "uri" },
            "original_excerpt": { "type": "string", "minLength": 1 },
            "excerpt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": true
        },
        "story_card": {
          "type": "object",
          "required": [
            "editorial_origin",
            "title",
            "summary",
            "characters",
            "conflict",
            "motifs",
            "imagery",
            "emotional_arc",
            "resonance",
            "non_fit",
            "content_warnings"
          ],
          "additionalProperties": true
        },
        "adaptation_boundary": {
          "type": "object",
          "required": ["must_preserve", "may_transform", "prohibited"],
          "additionalProperties": true
        },
        "theatre_asset_pack": {
          "type": "object",
          "required": ["asset_mode", "scene_anchors", "prohibited_visuals"],
          "additionalProperties": true
        },
        "rights_and_access": {
          "type": "object",
          "required": ["status", "access_mode", "copyright_basis", "allowed_uses"],
          "additionalProperties": true
        },
        "review_record": {
          "type": "object",
          "required": ["status", "reviewers", "required_reviews", "known_gaps"],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
