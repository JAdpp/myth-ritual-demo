{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/a1-semantic-review.schema.json",
  "title": "Mengdie A1 semantic reviewer response",
  "type": "object",
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/review" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["code", "field", "sourceExcerpt", "correctionHint"],
      "properties": {
        "code": {
          "enum": [
            "summary_actor",
            "summary_action_object",
            "summary_modality_negation",
            "summary_time",
            "summary_outcome",
            "summary_location",
            "summary_quantity",
            "summary_relation",
            "summary_causality",
            "summary_other_fact",
            "other_version",
            "narrative_sufficiency_mismatch",
            "key_entity_mismatch",
            "plot_beat_mismatch",
            "motif_mismatch",
            "label_life_context",
            "trigger_mismatch",
            "label_conflict",
            "label_agency",
            "label_ending",
            "safety_status_mismatch",
            "safety_omission",
            "safety_overreach",
            "safety_uncertainty_mismatch",
            "interpretation_risk_mismatch",
            "evidence_support_mismatch"
          ]
        },
        "field": {
          "enum": [
            "modernRetrievalSummary",
            "narrativeSufficiency",
            "keyEntities",
            "plotBeats",
            "motifTerms",
            "lifeContext",
            "narrativeArc.trigger",
            "narrativeArc.conflictTypes",
            "narrativeArc.agencyModes",
            "narrativeArc.endingMode",
            "autoSafetyScreen.status",
            "autoSafetyScreen.flags",
            "autoSafetyScreen.interpretationRisks",
            "autoSafetyScreen.uncertainties",
            "evidence.supports"
          ]
        },
        "sourceExcerpt": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "correctionHint": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        }
      },
      "additionalProperties": false
    },
    "checklist": {
      "type": "object",
      "required": [
        "modernRetrievalSummary",
        "narrativeSufficiency",
        "keyEntities",
        "plotBeats",
        "motifTerms",
        "lifeContext",
        "narrativeArc.trigger",
        "narrativeArc.conflictTypes",
        "narrativeArc.agencyModes",
        "narrativeArc.endingMode",
        "autoSafetyScreen.status",
        "autoSafetyScreen.flags",
        "autoSafetyScreen.interpretationRisks",
        "autoSafetyScreen.uncertainties",
        "evidence.supports"
      ],
      "properties": {
        "modernRetrievalSummary": { "type": "boolean" },
        "narrativeSufficiency": { "type": "boolean" },
        "keyEntities": { "type": "boolean" },
        "plotBeats": { "type": "boolean" },
        "motifTerms": { "type": "boolean" },
        "lifeContext": { "type": "boolean" },
        "narrativeArc.trigger": { "type": "boolean" },
        "narrativeArc.conflictTypes": { "type": "boolean" },
        "narrativeArc.agencyModes": { "type": "boolean" },
        "narrativeArc.endingMode": { "type": "boolean" },
        "autoSafetyScreen.status": { "type": "boolean" },
        "autoSafetyScreen.flags": { "type": "boolean" },
        "autoSafetyScreen.interpretationRisks": { "type": "boolean" },
        "autoSafetyScreen.uncertainties": { "type": "boolean" },
        "evidence.supports": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["entryId", "verdict", "checklist", "issues"],
      "properties": {
        "entryId": {
          "type": "string",
          "pattern": "^c1ws_[0-9a-f]{24}$"
        },
        "verdict": {
          "enum": ["pass", "revise", "uncertain"]
        },
        "checklist": { "$ref": "#/$defs/checklist" },
        "issues": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/issue" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verdict": { "const": "pass" } },
            "required": ["verdict"]
          },
          "then": {
            "properties": {
              "checklist": {
                "properties": {
                  "modernRetrievalSummary": { "const": true },
                  "narrativeSufficiency": { "const": true },
                  "keyEntities": { "const": true },
                  "plotBeats": { "const": true },
                  "motifTerms": { "const": true },
                  "lifeContext": { "const": true },
                  "narrativeArc.trigger": { "const": true },
                  "narrativeArc.conflictTypes": { "const": true },
                  "narrativeArc.agencyModes": { "const": true },
                  "narrativeArc.endingMode": { "const": true },
                  "autoSafetyScreen.status": { "const": true },
                  "autoSafetyScreen.flags": { "const": true },
                  "autoSafetyScreen.interpretationRisks": { "const": true },
                  "autoSafetyScreen.uncertainties": { "const": true },
                  "evidence.supports": { "const": true }
                }
              },
              "issues": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": { "issues": { "minItems": 1 } }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
