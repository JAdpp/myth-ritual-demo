{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/branch-suggestions.schema.json",
  "title": "Constrained co-creation suggestion output",
  "type": "object",
  "required": ["nodeId", "suggestions"],
  "properties": {
    "nodeId": {
      "enum": [
        "world_crack",
        "cross_threshold",
        "allies_resources",
        "new_understanding",
        "bring_back"
      ]
    },
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "sourceClaims": {
      "type": "array",
      "maxItems": 0,
      "description": "The model is never allowed to create source-canon claims."
    }
  },
  "additionalProperties": false
}

