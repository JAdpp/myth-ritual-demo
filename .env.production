# Production builds must talk to the API through a relative path, so that the
# bundle works behind whatever host and port nginx serves it on.
#
# This file exists because `.env` carries a localhost API base for local
# development, and Vite bakes VITE_* values into the bundle at build time. A
# production build that picked that up would ship a browser bundle calling
# 127.0.0.1, which fails CORS on the deployed site. `.env.production` takes
# precedence over `.env` in production mode, so the empty value wins here.
VITE_API_BASE_URL=
