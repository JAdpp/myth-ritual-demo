# Browser-visible configuration. Never place provider secrets behind VITE_*.
VITE_API_BASE_URL=http://127.0.0.1:8010

# Server-only LLM configuration. Keep real values only in ignored .env or a secret manager.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
ENABLE_LIVE_MODEL_GENERATION=false

# Optional image generation; disabled unless explicitly enabled and audited.
DASHSCOPE_API_KEY=
ALIYUN_IMAGE_API_HOST=
ALIYUN_IMAGE_MODEL=z-image-turbo
ALIYUN_IMAGE_TIMEOUT_SECONDS=60
# Optional same-region public endpoint and outbound proxy. Never put these behind VITE_*.
ALIYUN_IMAGE_FALLBACK_API_HOST=
ALIYUN_IMAGE_PROXY_URL=
ALIYUN_IMAGE_IPV6_FALLBACK_ENABLED=false
ENABLE_IMAGE_GENERATION=false

# Development storage and privacy defaults.
STORE_MODE=memory
UNSAVED_SESSION_TTL_HOURS=24
SAVED_ARTIFACT_TTL_DAYS=30
ALLOW_PRIVATE_TEXT_TO_LLM=false
